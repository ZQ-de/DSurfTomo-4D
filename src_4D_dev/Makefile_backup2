CMD = DSurfTomo
FC = gfortran
FFLAGS  = -O3 -ffixed-line-length-none -ffree-form -ffloat-store\
           -fbounds-check -m64 -mcmodel=medium -Wall
F90SRCS = lsmrDataModule.f90 lsmrblasInterface.f90\
          lsmrblas.f90 lsmrModule.f90 delsph.f90\
              aprod.f90 gaussian.f90 getpercentile.f90
FSRCS =  surfdisp96.f slarnv.f slaruv.f
OBJS = $(F90SRCS:%.f90=%.o) $(FSRCS:%.f=%.o) CalSurfG.o main.o
MODDIR = ./modules
FFLAGS += -J$(MODDIR) -I$(MODDIR)

all: $(MODDIR) $(CMD)

$(MODDIR):
	mkdir -p $(MODDIR)

$(CMD): $(OBJS)
	$(FC) $(FFLAGS) -o $@ $(OBJS)

%.o: %.f90
	$(FC) $(FFLAGS) -c $< -o $@

%.o: %.f
	$(FC) $(FFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJS) $(CMD) $(MODDIR) *.mod
